<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Live Count Perolehan Suara — E-Voting OSIS SMAN 1 Gianyar</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>

  <div class="app-container" style="max-width: 1140px;">

    <!-- Header Navbar -->
    <header class="app-header">
      <div class="brand-section">
        <div class="brand-logo">
          <img src="/assets/logo_dosman.jpg" alt="Logo SMAN 1 Gianyar">
        </div>
        <div>
          <h1 class="brand-title">LIVE COUNT E-VOTING OSIS</h1>
          <p class="brand-subtitle">SMA Negeri 1 Gianyar &middot; Pemantauan Perolehan Suara Real-Time</p>
        </div>
      </div>

      <div style="display: flex; align-items: center; gap: 8px; flex-wrap: wrap;">
        <div style="display: flex; align-items: center; gap: 6px; background: rgba(16, 185, 129, 0.15); border: 1px solid rgba(16, 185, 129, 0.3); padding: 5px 10px; border-radius: 30px; color: #34d399; font-size: 10.5px; font-weight: 800; white-space: nowrap;">
          <span style="width: 6px; height: 6px; border-radius: 50%; background: #10b981; flex-shrink: 0;"></span>
          LIVE (<span id="liveTimestamp">...</span>)
        </div>
        <a href="/login" class="btn-primary" style="padding: 6px 12px; border-radius: 20px; text-decoration: none; font-size: 11px; font-weight: 800; background: linear-gradient(135deg, #6366f1, #3b82f6); color: white; white-space: nowrap;">
          🔑 BILIK SUARA
        </a>
      </div>
    </header>

    <!-- Main Container Card -->
    <div class="quickcount-card">
      
      <div style="text-align: center;">
        <h2 class="quickcount-header-title">PEROLEHAN SUARA PILKATOS REAL-TIME</h2>
        <p class="quickcount-header-subtitle">Data dihitung secara otomatis dan akurat langsung dari bilik suara digital</p>
      </div>

      <!-- Quick Stats Widgets (Ringkas 4 Cards dalam 1 Row Desktop / 2x2 Grid Mobile) -->
      <div class="quick-stats-grid">
        <div class="stat-widget-card voters">
          <p class="stat-widget-label">Total DPT Pemilih</p>
          <p id="statTotalVoters" class="stat-widget-value">—</p>
        </div>
        <div class="stat-widget-card votes">
          <p class="stat-widget-label">Total Suara Masuk</p>
          <p id="statTotalVotes" class="stat-widget-value">—</p>
        </div>
        <div class="stat-widget-card turnout">
          <p class="stat-widget-label">Kehadiran</p>
          <p id="statTurnoutPercent" class="stat-widget-value">—%</p>
        </div>
        <div class="stat-widget-card remaining">
          <p class="stat-widget-label">Belum Memilih</p>
          <p id="statRemainingVoters" class="stat-widget-value">—</p>
        </div>
      </div>

      <!-- Grid Kanan-Kiri Paslon 01 & Paslon 02 (Berdampingan Dalam 1 Baris di HP) -->
      <div id="paslonGridContainer" class="quickcount-paslon-grid">
        <!-- Filled dynamically by SSE / Fetch -->
      </div>

      <!-- Total Perolehan Suara Abstain (Di Bawahnya) -->
      <div id="summaryTallyContainer">
        <!-- Filled dynamically underneath -->
      </div>

    </div>

    <!-- Footer -->
    <div style="text-align: center; color: rgba(255,255,255,0.7); font-size: 12px; margin-bottom: 24px;">
      &copy; 2026 SMAN 1 Gianyar &middot; Widya Wahana Bhakti &middot; E-Voting Digital System
    </div>

  </div>

  <!-- Real-time SSE / Polling Script -->
  <script>
    // Smooth 1-second digital clock for header badge
    function updateLiveClock() {
      const clockEl = document.getElementById('liveTimestamp');
      if (clockEl) {
        clockEl.textContent = new Date().toLocaleTimeString('id-ID');
      }
    }
    setInterval(updateLiveClock, 1000);
    updateLiveClock();

    function updateTallyUI(data) {
      document.getElementById('statTotalVoters').textContent = data.total_voters.toLocaleString();
      document.getElementById('statTotalVotes').textContent = data.total_votes.toLocaleString();
      document.getElementById('statTurnoutPercent').textContent = data.turnout_percent + '%';
      document.getElementById('statRemainingVoters').textContent = data.remaining_voters.toLocaleString();

      const paslonGrid = document.getElementById('paslonGridContainer');
      const summaryContainer = document.getElementById('summaryTallyContainer');

      paslonGrid.innerHTML = '';
      summaryContainer.innerHTML = '';

      // Render Paslon 01 & Paslon 02 side-by-side (Kanan Kiri 1 Baris)
      data.candidates.forEach(c => {
        const card = document.createElement('div');
        const isPaslon1 = c.candidate_number === 1;

        card.className = `paslon-tally-card paslon-${c.candidate_number}`;

        const colorGradient = isPaslon1 
          ? 'linear-gradient(90deg, #f59e0b, #d97706)' 
          : 'linear-gradient(90deg, #6366f1, #3b82f6)';

        card.innerHTML = `
          <div>
            <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 12px; flex-wrap: wrap; gap: 4px;">
              <span class="paslon-badge-static ${isPaslon1 ? '' : 'paslon-2'}">
                CALON 0${c.candidate_number}
              </span>
              <span class="tally-vote-count">
                ${c.count.toLocaleString()} Suara Sah
              </span>
            </div>

            <div style="display: flex; gap: 16px; align-items: center; margin-top: 10px; margin-bottom: 14px;">
              ${c.photo ? `
                <div class="tally-photo-wrapper" style="border: 2px solid ${isPaslon1 ? '#fde68a' : '#c7d2fe'};">
                  <img src="${c.photo}" alt="${c.name}" style="width: 100%; height: 100%; object-fit: cover; object-position: center top;">
                </div>
              ` : ''}
              <div style="flex: 1; min-width: 0;">
                <h3 class="tally-candidate-name">
                  ${c.name}
                </h3>
                <p class="tally-candidate-subtitle">Calon Ketua OSIS 2026/2027</p>
              </div>
            </div>
          </div>

          <div style="margin-top: 10px;">
            <div style="display: flex; align-items: baseline; justify-content: space-between; margin-bottom: 6px;">
              <span class="tally-percent">${c.percentage}%</span>
              <span style="font-size: 12px; color: #64748b; font-weight: 700;">Perolehan Suara</span>
            </div>
            <div class="progress-bar-bg" style="height: 12px; border-radius: 8px; background: #e2e8f0; overflow: hidden;">
              <div class="progress-bar-fill" style="width: ${c.percentage}%; height: 100%; background: ${colorGradient}; border-radius: 8px; transition: width 0.6s ease;"></div>
            </div>
          </div>
        `;
        paslonGrid.appendChild(card);
      });

      // Render Abstain Card (Di Bawahnya)
      if (data.abstain) {
        const summaryCard = document.createElement('div');
        summaryCard.style.background = '#f8fafc';
        summaryCard.style.border = '1px solid #cbd5e1';
        summaryCard.style.borderRadius = '14px';
        summaryCard.style.padding = '12px 16px';
        summaryCard.style.marginTop = '4px';

        summaryCard.innerHTML = `
          <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 6px; flex-wrap: wrap; gap: 4px;">
            <div style="display: flex; align-items: center; gap: 8px;">
              <span style="background: #e2e8f0; color: #475569; font-weight: 900; font-size: 10.5px; padding: 3px 10px; border-radius: 20px;">
                ABSTAIN
              </span>
              <span style="font-size: 12px; font-weight: 800; color: #334155;">Suara Tidak Memilih</span>
            </div>
            <div style="text-align: right;">
              <span style="font-size: 16px; font-weight: 900; color: #475569;">${data.abstain.percentage}%</span>
              <span style="font-size: 11px; color: #64748b; margin-left: 4px; font-weight: 700;">(${data.abstain.count.toLocaleString()} suara)</span>
            </div>
          </div>
          <div class="progress-bar-bg" style="height: 8px; border-radius: 6px; background: #e2e8f0; overflow: hidden;">
            <div class="progress-bar-fill" style="width: ${data.abstain.percentage}%; height: 100%; background: #64748b; border-radius: 6px; transition: width 0.6s ease;"></div>
          </div>
        `;
        summaryContainer.appendChild(summaryCard);
      }
    }

    // Connect via SSE (Server-Sent Events) or Fallback Fetch Polling
    if (!!window.EventSource) {
      const source = new EventSource('/admin/realtime-sse');
      source.onmessage = function(event) {
        const data = JSON.parse(event.data);
        updateTallyUI(data);
      };
      source.onerror = function() {
        setInterval(() => {
          fetch('/admin/realtime-json').then(r => r.json()).then(updateTallyUI);
        }, 2000);
      };
    } else {
      setInterval(() => {
        fetch('/admin/realtime-json').then(r => r.json()).then(updateTallyUI);
      }, 2000);
    }
  </script>

</body>
</html>
