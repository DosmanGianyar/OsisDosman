<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Bilik Suara E-Voting OSIS — SMAN 1 Gianyar</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>

  <div class="app-container">

    <!-- Header Navbar -->
    <header class="app-header">
      <div class="brand-section">
        <div class="brand-logo">
          <img src="/assets/logo_dosman.jpg" alt="Logo SMAN 1 Gianyar">
        </div>
        <div>
          <h1 class="brand-title">E-VOTING OSIS</h1>
          <p class="brand-subtitle">SMA Negeri 1 Gianyar &middot; LUBER JURDIL</p>
        </div>
      </div>

      <div class="user-badge">
        <span style="width: 8px; height: 8px; border-radius: 50%; background: #10b981;"></span>
        <%= user.name %> (<%= user.role.toUpperCase() %>)
        <a href="/logout" style="color: rgba(255,255,255,0.7); text-decoration: none; margin-left: 8px; font-size: 11px;">Logout</a>
      </div>
    </header>

    <!-- Banner Session -->
    <div class="session-banner" style="background: rgba(255,255,255,0.1); border: 1px solid rgba(255,255,255,0.2); border-radius: 20px; padding: 20px 24px; color: #fff; margin-bottom: 24px;">
      <h2 style="font-size: 20px; font-weight: 800;"><%= session.title %></h2>
      <p style="font-size: 13px; color: rgba(255,255,255,0.85); margin-top: 4px;"><%= session.description %></p>
    </div>

    <% if (error) { %>
      <div class="alert-banner alert-error">
        <svg style="width: 20px; height: 20px;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
        </svg>
        <div><%= error %></div>
      </div>
    <% } %>

    <!-- Form Voting Form -->
    <form id="voteForm" action="/voting/vote" method="POST">
      <input type="hidden" name="candidate_id" id="selectedCandidateId" value="">

      <!-- Grid 2 Calon Ketua OSIS -->
      <div class="candidate-grid">
        <% candidates.forEach(candidate => { %>
          <div class="candidate-card">
            
            <!-- Badge Calon Header (Terlihat Jelas 100% Tanpa Terpotong) -->
            <div class="card-badge-header">
              <span class="paslon-badge-static <%= candidate.candidate_number === 2 ? 'paslon-2' : '' %>">
                CALON 0<%= candidate.candidate_number %>
              </span>
            </div>

            <!-- Wrapper Foto Close-up Candidate -->
            <div class="candidate-image-wrapper" onclick="triggerCandidateSelection(<%= candidate.id %>, 'CALON 0<%= candidate.candidate_number %>', '<%= candidate.name %>')" title="Klik foto untuk memilih CALON 0<%= candidate.candidate_number %>">
              <% if (candidate.photo) { %>
                <img src="<%= candidate.photo %>" alt="<%= candidate.name %>" class="candidate-image">
              <% } else { %>
                <div style="width: 100%; height: 100%; display: flex; flex-direction: column; align-items: center; justify-content: center; color: #94a3b8;">
                  <svg style="width: 48px; height: 48px;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
                  </svg>
                  <span style="font-size: 11px; margin-top: 6px;">Foto Calon 0<%= candidate.candidate_number %></span>
                </div>
              <% } %>
            </div>

            <div class="candidate-body">
              <h3 class="candidate-name"><%= candidate.name %></h3>

              <% if (candidate.motto) { %>
                <div class="motto-box">"<%= candidate.motto %>"</div>
              <% } %>

              <!-- Tombol Modal Detail Visi & Misi -->
              <button type="button" class="btn-toggle-details"
                data-candidate-id="<%= candidate.id %>"
                data-number="0<%= candidate.candidate_number %>"
                data-name="<%= candidate.name %>"
                data-photo="<%= candidate.photo || '' %>"
                data-motto="<%= candidate.motto || '' %>"
                data-vision="<%= candidate.vision || '' %>"
                data-mission="<%= candidate.mission || '' %>"
                data-programs="<%= candidate.programs || '' %>"
                onclick="openVisionModalFromButton(this)">
                <span>📋 Detail Visi &amp; Misi</span>
              </button>

              <!-- Tombol Coblos Utama -->
              <button type="button" class="btn-coblos" onclick="triggerCandidateSelection(<%= candidate.id %>, 'CALON 0<%= candidate.candidate_number %>', '<%= candidate.name %>')">
                <svg style="width: 16px; height: 16px; flex-shrink: 0;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
                </svg>
                <span>COBLOS CALON 0<%= candidate.candidate_number %></span>
              </button>
            </div>

          </div>
        <% }) %>
      </div>

    </form>

  </div>

  <!-- Modal Detail Visi & Misi Calon -->
  <div class="modal-overlay" id="visionModal">
    <div class="modal-box modal-box-lg">
      
      <!-- Header Modal -->
      <div class="modal-header-custom">
        <div style="display: flex; align-items: center; gap: 10px;">
          <span id="visionModalBadge" class="paslon-badge-static" style="font-size: 11px; padding: 4px 12px;">CALON 01</span>
          <h3 style="font-size: 17px; font-weight: 800; color: #0f172a; margin: 0;">Detail Visi &amp; Misi</h3>
        </div>
        <button type="button" class="modal-close-btn" onclick="closeVisionModal()">&times;</button>
      </div>

      <!-- Scrollable Body -->
      <div class="modal-scroll-body">
        
        <!-- Profile Mini Banner -->
        <div class="modal-candidate-profile">
          <img id="visionModalPhoto" src="" alt="" class="modal-candidate-avatar" style="display: none;">
          <div>
            <h4 id="visionModalName" style="font-size: 17px; font-weight: 800; color: #0f172a; line-height: 1.25;">—</h4>
            <p id="visionModalMotto" style="font-size: 12px; font-style: italic; color: #475569; margin-top: 4px; display: none;"></p>
          </div>
        </div>

        <!-- Section Visi -->
        <div id="visionSectionContainer" class="modal-vision-card">
          <div class="modal-section-title" style="color: #0284c7;">
            <span>🎯</span> VISI CALON
          </div>
          <p id="visionModalVision" class="section-text" style="font-size: 13.5px; color: #0c4a6e; font-weight: 500; margin: 0;"></p>
        </div>

        <!-- Section Misi -->
        <div id="missionSectionContainer" class="modal-mission-card">
          <div class="modal-section-title" style="color: #4f46e5;">
            <span>🚀</span> MISI CALON
          </div>
          <p id="visionModalMission" class="section-text" style="font-size: 13.5px; color: #334155; margin: 0;"></p>
        </div>

        <!-- Section Program Kerja -->
        <div id="programsSectionContainer" class="modal-program-card">
          <div class="modal-section-title" style="color: #d97706;">
            <span>💡</span> PROGRAM KERJA UNGGULAN
          </div>
          <p id="visionModalPrograms" class="section-text" style="font-size: 13.5px; color: #78350f; margin: 0;"></p>
        </div>

      </div>

      <!-- Action Footer -->
      <div style="display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-top: 18px; padding-top: 14px; border-top: 1px solid #e2e8f0;">
        <button type="button" class="btn-modal-cancel" style="width: auto; padding: 12px 20px;" onclick="closeVisionModal()">Tutup</button>
        <button type="button" id="visionModalCoblosBtn" class="btn-coblos" style="width: auto; padding: 12px 22px; font-size: 14px;">
          <span>COBLOS CALON INI</span>
        </button>
      </div>

    </div>
  </div>

  <!-- Modal Konfirmasi Ballot -->
  <div class="modal-overlay" id="confirmModal">
    <div class="modal-box">
      <div style="width: 56px; height: 56px; border-radius: 50%; background: #e0e7ff; color: #4f46e5; display: flex; align-items: center; justify-content: center; margin: 0 auto 16px auto; font-size: 28px;">
        🗳️
      </div>

      <h3 style="font-size: 20px; font-weight: 800; color: #0f172a; margin-bottom: 4px;">Konfirmasi Pilihan Suara</h3>
      <p style="font-size: 13px; color: #64748b; margin-bottom: 20px;">Apakah Anda yakin dengan pilihan Anda?</p>

      <div style="background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 16px; padding: 16px; margin-bottom: 20px;">
        <span id="modalPaslonBadge" class="paslon-badge" style="position: static; display: inline-block; margin-bottom: 8px;">CALON 01</span>
        <h4 id="modalPaslonName" style="font-size: 16px; font-weight: 800; color: #0f172a;">—</h4>
        <p id="modalPaslonVice" style="font-size: 13px; font-weight: 700; color: #4f46e5; margin-top: 2px; display: none;"></p>
      </div>

      <p style="font-size: 11px; color: #94a3b8; margin-bottom: 20px; line-height: 1.5;">
        ⚠️ Pilihan bersifat <strong style="color: #0f172a;">RAHASIA</strong> &amp; <strong style="color: #0f172a;">FINAL</strong>.<br>
        Setelah dikirim, Anda akan <strong style="color: #f43f5e;">otomatis keluar dari sistem (logout)</strong>.
      </p>

      <div class="modal-actions">
        <button type="button" class="btn-modal-cancel" id="btnCancelModal" onclick="closeModal()">Batal / Cek Lagi</button>
        <button type="button" class="btn-modal-confirm" id="btnConfirmSubmit" onclick="executeSubmitVote()">
          <span>SAH! KIRIM SUARA</span>
        </button>
      </div>
    </div>
  </div>

  <script>
    let isSubmitting = false;

    function openVisionModalFromButton(btn) {
      const candidateId = btn.dataset.candidateId;
      const number = btn.dataset.number;
      const name = btn.dataset.name;
      const photo = btn.dataset.photo;
      const motto = btn.dataset.motto;
      const vision = btn.dataset.vision;
      const mission = btn.dataset.mission;
      const programs = btn.dataset.programs;

      document.getElementById('visionModalBadge').textContent = 'CALON ' + number;
      if (number === '02') {
        document.getElementById('visionModalBadge').classList.add('paslon-2');
      } else {
        document.getElementById('visionModalBadge').classList.remove('paslon-2');
      }

      document.getElementById('visionModalName').textContent = name;

      const photoEl = document.getElementById('visionModalPhoto');
      if (photo) {
        photoEl.src = photo;
        photoEl.style.display = 'block';
      } else {
        photoEl.style.display = 'none';
      }

      const mottoEl = document.getElementById('visionModalMotto');
      if (motto) {
        mottoEl.textContent = '"' + motto + '"';
        mottoEl.style.display = 'block';
      } else {
        mottoEl.style.display = 'none';
      }

      const visionEl = document.getElementById('visionModalVision');
      const visionBox = document.getElementById('visionSectionContainer');
      if (vision && vision.trim() !== '') {
        visionEl.textContent = vision;
        visionBox.style.display = 'block';
      } else {
        visionBox.style.display = 'none';
      }

      const missionEl = document.getElementById('visionModalMission');
      const missionBox = document.getElementById('missionSectionContainer');
      if (mission && mission.trim() !== '') {
        missionEl.textContent = mission;
        missionBox.style.display = 'block';
      } else {
        missionBox.style.display = 'none';
      }

      const programsEl = document.getElementById('visionModalPrograms');
      const programsBox = document.getElementById('programsSectionContainer');
      if (programs && programs.trim() !== '') {
        programsEl.textContent = programs;
        programsBox.style.display = 'block';
      } else {
        programsBox.style.display = 'none';
      }

      const coblosBtn = document.getElementById('visionModalCoblosBtn');
      coblosBtn.onclick = function() {
        closeVisionModal();
        triggerCandidateSelection(candidateId, 'CALON ' + number, name);
      };

      document.getElementById('visionModal').classList.add('active');
    }

    function closeVisionModal() {
      document.getElementById('visionModal').classList.remove('active');
    }

    function triggerCandidateSelection(candidateId, badgeText, name) {
      if (isSubmitting) return;
      document.getElementById('selectedCandidateId').value = candidateId;
      document.getElementById('modalPaslonBadge').textContent = badgeText;
      document.getElementById('modalPaslonName').textContent = name;
      openModal();
    }

    function openModal() {
      document.getElementById('confirmModal').classList.add('active');
    }

    function closeModal() {
      if (isSubmitting) return;
      document.getElementById('confirmModal').classList.remove('active');
    }

    function executeSubmitVote() {
      if (isSubmitting) return;
      isSubmitting = true;

      const confirmBtn = document.getElementById('btnConfirmSubmit');
      const cancelBtn = document.getElementById('btnCancelModal');

      confirmBtn.disabled = true;
      cancelBtn.disabled = true;
      confirmBtn.style.opacity = '0.75';
      confirmBtn.style.cursor = 'not-allowed';

      confirmBtn.innerHTML = `
        <div class="spinner"></div>
        <span>MEMPROSES SUARA...</span>
      `;

      document.getElementById('voteForm').submit();
    }
  </script>

</body>
</html>
